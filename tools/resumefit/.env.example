# Get a Groq API key at https://console.groq.com/keys (free tier has rate limits).
# Do not commit your real key. Groq takes priority unless AI_PROVIDER=openai is set.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI API route (billed separately from ChatGPT Plus):
# Set AI_PROVIDER=openai and your OPENAI_API_KEY in Render Environment.
# Recommended affordable GPT-6 model: gpt-6-luna. Higher capability: gpt-6-sol.
# To use Groq instead, leave AI_PROVIDER unset.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Without either key: manual editing, local skills sorting and DOCX export still work.
# RESUMEFIT_SESSION_DIR=/tmp/resumefit-sessions
