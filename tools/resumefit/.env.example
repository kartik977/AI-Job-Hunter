# Get a Groq API key at https://console.groq.com/keys (free tier has rate limits).
# Do not commit your real key. Groq takes priority when both keys are present.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional paid alternative; leave empty if you want Groq only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Without either key: manual editing, local skills sorting and DOCX export still work.
# RESUMEFIT_SESSION_DIR=/tmp/resumefit-sessions
